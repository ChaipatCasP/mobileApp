<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_table_card_available"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row: table name + seats row on left, icon on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTableName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/table_title_dark" />

            <TextView
                android:id="@+id/tvSeats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4 Seats"
                android:textSize="12sp"
                android:textColor="@color/table_subtitle"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_check_circle" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: status label + value -->
    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AVAILABLE"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:textColor="@color/table_available_text" />

    <TextView
        android:id="@+id/tvStatusValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:textColor="@color/table_title_dark" />

</LinearLayout>
