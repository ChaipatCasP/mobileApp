<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- ===== Bottom Navigation Bar ===== -->
    <LinearLayout
        android:id="@+id/tableBottomNavBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- TABLES Tab (active) -->
        <LinearLayout
            android:id="@+id/tabTables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tables"
                app:tint="@color/blue_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TABLES"
                android:textColor="@color/blue_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ORDERS Tab -->
        <LinearLayout
            android:id="@+id/tabOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_orders"
                app:tint="@color/text_gray" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORDERS"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- MENU Tab -->
        <LinearLayout
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_food"
                app:tint="@color/text_gray" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENU"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- MORE Tab -->
        <LinearLayout
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_more_settings"
                app:tint="@color/text_gray" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MORE"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ===== Main Content Area ===== -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tableBottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp">

            <!-- Grid icon -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_tables"
                app:tint="@color/blue_primary" />

            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Main Floor"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/table_title_dark"
                android:layout_marginStart="10dp" />

            <!-- Add (+) button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAddTable"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardCornerRadius="19dp"
                app:cardBackgroundColor="@color/table_reserved_bg"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/blue_primary" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ===== Segment Control: Table View | Queue List ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_segment_container"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/segTableView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Table View"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/table_title_dark"
                android:background="@drawable/bg_segment_selected" />

            <TextView
                android:id="@+id/segQueueList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Queue List"
                android:textSize="14sp"
                android:textColor="@color/text_gray"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <!-- ===== Filter Chips ===== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Available chip -->
                <LinearLayout
                    android:id="@+id/chipAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_filter_chip"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_green"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/tvAvailableCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available (0)"
                        android:textSize="12sp"
                        android:textColor="@color/table_title_dark" />
                </LinearLayout>

                <!-- Occupied chip -->
                <LinearLayout
                    android:id="@+id/chipOccupied"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_filter_chip"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_orange"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/tvOccupiedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Occupied (0)"
                        android:textSize="12sp"
                        android:textColor="@color/table_title_dark" />
                </LinearLayout>

                <!-- Reserved chip -->
                <LinearLayout
                    android:id="@+id/chipReserved"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_filter_chip"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_blue"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/tvReservedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reserved (0)"
                        android:textSize="12sp"
                        android:textColor="@color/table_title_dark" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ===== Loading / Error State ===== -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#E53935"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- ===== Table Grid ===== -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTables"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
